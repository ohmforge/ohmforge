(export (version "E")
  (design
    (source "divider.kicad_sch")
    (tool "ohmforge example"))
  (components
    (comp (ref "V1")
      (value "DC 10")
      (footprint "ee:Source"))
    (comp (ref "R1")
      (value "1k")
      (footprint "Resistor_SMD:R_0603"))
    (comp (ref "R2")
      (value "1k")
      (footprint "Resistor_SMD:R_0603")))
  (nets
    (net (code "1") (name "/in")
      (node (ref "V1") (pin "1"))
      (node (ref "R1") (pin "1")))
    (net (code "2") (name "/out")
      (node (ref "R1") (pin "2"))
      (node (ref "R2") (pin "1")))
    (net (code "3") (name "GND")
      (node (ref "V1") (pin "2"))
      (node (ref "R2") (pin "2")))))
