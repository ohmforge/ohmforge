# Normalize all text files to LF in the working tree on every platform.
# ohmforge has byte-exact golden-file tests (e.g. the native project round-trip
# in ohmforge-fmt compares save() output to a checked-in fixture); without this,
# Windows checkouts get CRLF and those comparisons fail. Binaries are left alone
# by git's auto-detection.
* text=auto eol=lf
